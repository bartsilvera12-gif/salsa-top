# ============================================================================
# Salsa Top — sitio estático (Next.js `output: export`) en Hostinger (Apache)
# Copiar TODO el contenido de out/ (incluido este archivo) dentro de public_html.
# El sitio funciona SIN Node.js.
# ============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html
RewriteEngine On

# --- HTTPS forzado (Hostinger ya provee el SSL) ---
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Ruteo de Next export (trailingSlash) ---
# Next genera cada ruta como /ruta/index.html. Apache sirve la carpeta con el
# index.html automáticamente. Si la petición NO es un archivo ni carpeta real,
# se intenta la versión .html; si no existe, cae al 404 de Next.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html

# --- MIME types (por si el hosting no los trae) ---
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/json .json .webmanifest
</IfModule>

# --- Compresión ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml font/woff2
</IfModule>

# --- Caché ---
<IfModule mod_headers.c>
  # Assets con hash de Next: cache larga e inmutable
  <FilesMatch "\.(js|mjs|css|woff2|jpg|jpeg|png|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML: sin caché agresiva para que se vean los cambios al re-subir
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
