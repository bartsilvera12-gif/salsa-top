# ==========================================================================
# Salsa Top — Variables de entorno (COPIAR a .env.local y completar)
# NO subir .env.local ni secretos reales al repositorio.
# ==========================================================================

# URL pública de Supabase (self-hosted en Coolify o Supabase Cloud)
NEXT_PUBLIC_SUPABASE_URL=https://tu-supabase.tudominio.com

# Clave anónima (pública, segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role — SOLO SERVIDOR. Nunca exponer al navegador.
# Se usa en Server Actions / rutas de servidor con privilegios elevados.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para SEO, canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://salsatop.com.py

# Número de WhatsApp de la marca (solo dígitos, con código de país)
NEXT_PUBLIC_WHATSAPP_NUMBER=595994208200
